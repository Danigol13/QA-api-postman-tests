{
  "info": {
    "name": "RestfulBooker — QA API Tests",
    "description": "Collection de testes de API REST para a Restful Booker API. Cobre autenticação, CRUD de reservas, testes positivos/negativos, validação de contratos JSON e encadeamento de requisições.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "description": "Cenários de autenticação e geração de token.",
      "item": [
        {
          "name": "CT001 - Gerar Token de Acesso",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth",
            "description": "Gera um token de acesso com credenciais válidas. O token é salvo na variável de ambiente para uso nos CTs subsequentes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT001 - Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CT001 - Resposta contém token', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('CT001 - Token salvo no ambiente', function () {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('token', json.token);",
                  "  pm.expect(pm.environment.get('token')).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test('CT001 - Content-Type é application/json', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT002 - Gerar Token com Credenciais Inválidas",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"username\": \"usuario_invalido\",\n  \"password\": \"senha_invalida\"\n}"
            },
            "url": "{{baseUrl}}/auth",
            "description": "Tenta gerar token com credenciais inválidas. Espera-se retorno com mensagem 'Bad credentials'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT002 - Status 200 (comportamento da API)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CT002 - Resposta contém reason Bad credentials', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('reason');",
                  "  pm.expect(json.reason).to.eql('Bad credentials');",
                  "});",
                  "",
                  "pm.test('CT002 - Não retorna token válido', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.not.have.property('token');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reservas",
      "description": "Cenários de CRUD completo de reservas.",
      "item": [
        {
          "name": "CT003 - Listar Todas as Reservas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/booking",
            "description": "Lista todas as reservas existentes. Espera-se array não vazio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT003 - Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CT003 - Resposta é um array', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('CT003 - Array contém ao menos uma reserva', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('CT003 - Cada item possui bookingid', function () {",
                  "  const json = pm.response.json();",
                  "  json.forEach(function (item) {",
                  "    pm.expect(item).to.have.property('bookingid');",
                  "    pm.expect(item.bookingid).to.be.a('number');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT004 - Criar Reserva com Dados Válidos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"firstname\": \"Daniel\",\n  \"lastname\": \"Souza\",\n  \"totalprice\": 500,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2025-01-10\",\n    \"checkout\": \"2025-01-15\"\n  },\n  \"additionalneeds\": \"Café da manhã\"\n}"
            },
            "url": "{{baseUrl}}/booking",
            "description": "Cria uma nova reserva com dados válidos. O bookingId é salvo para uso nos CTs posteriores."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT004 - Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CT004 - Resposta contém bookingid', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('bookingid');",
                  "  pm.expect(json.bookingid).to.be.a('number');",
                  "  pm.environment.set('bookingId', json.bookingid);",
                  "});",
                  "",
                  "pm.test('CT004 - Dados da reserva retornados corretamente', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.booking.firstname).to.eql('Daniel');",
                  "  pm.expect(json.booking.lastname).to.eql('Souza');",
                  "  pm.expect(json.booking.totalprice).to.eql(500);",
                  "  pm.expect(json.booking.depositpaid).to.be.true;",
                  "});",
                  "",
                  "pm.test('CT004 - bookingId salvo no ambiente', function () {",
                  "  pm.expect(pm.environment.get('bookingId')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
