    {
      "name": "Validações Gerais",
      "description": "Validações de contrato JSON, códigos HTTP e tratamento de erros.",
      "item": [
        {
          "name": "CT015 - Validar Contrato JSON da Criação",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"firstname\": \"Contrato\",\n  \"lastname\": \"JSON\",\n  \"totalprice\": 200,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2025-06-01\",\n    \"checkout\": \"2025-06-05\"\n  },\n  \"additionalneeds\": \"Nenhum\"\n}"
            },
            "url": "{{baseUrl}}/booking",
            "description": "Valida o contrato JSON completo da resposta de criação de reserva."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT015 - Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CT015 - Contrato: resposta possui bookingid (number)', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('bookingid').that.is.a('number');",
                  "});",
                  "",
                  "pm.test('CT015 - Contrato: resposta possui booking (object)', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('booking').that.is.an('object');",
                  "});",
                  "",
                  "pm.test('CT015 - Contrato: booking.firstname (string)', function () {",
                  "  pm.expect(pm.response.json().booking.firstname).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('CT015 - Contrato: booking.lastname (string)', function () {",
                  "  pm.expect(pm.response.json().booking.lastname).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('CT015 - Contrato: booking.totalprice (number)', function () {",
                  "  pm.expect(pm.response.json().booking.totalprice).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('CT015 - Contrato: booking.depositpaid (boolean)', function () {",
                  "  pm.expect(pm.response.json().booking.depositpaid).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('CT015 - Contrato: booking.bookingdates.checkin (string)', function () {",
                  "  pm.expect(pm.response.json().booking.bookingdates.checkin).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('CT015 - Contrato: booking.bookingdates.checkout (string)', function () {",
                  "  pm.expect(pm.response.json().booking.bookingdates.checkout).to.be.a('string');",
                  "});",
                  "",
                  "// Limpeza: salva ID para deletar após validação",
                  "const json = pm.response.json();",
                  "if (json.bookingid) pm.environment.set('bookingIdContrato', json.bookingid);"
                ]
              }
            }
          ]
        },
        {
          "name": "CT016 - Validar Contrato JSON da Consulta",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/booking/{{bookingId}}",
            "description": "Valida o contrato JSON completo da resposta de consulta de reserva."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT016 - Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CT016 - Contrato: possui todos os campos obrigatórios', function () {",
                  "  const json = pm.response.json();",
                  "  const camposObrigatorios = ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'];",
                  "  camposObrigatorios.forEach(function (campo) {",
                  "    pm.expect(json, 'Campo ausente: ' + campo).to.have.property(campo);",
                  "  });",
                  "});",
                  "",
                  "pm.test('CT016 - Contrato: bookingdates possui checkin e checkout', function () {",
                  "  const dates = pm.response.json().bookingdates;",
                  "  pm.expect(dates).to.have.property('checkin');",
                  "  pm.expect(dates).to.have.property('checkout');",
                  "});",
                  "",
                  "pm.test('CT016 - Contrato: tipos de dados corretos', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.firstname).to.be.a('string');",
                  "  pm.expect(json.lastname).to.be.a('string');",
                  "  pm.expect(json.totalprice).to.be.a('number');",
                  "  pm.expect(json.depositpaid).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT017 - Validar Códigos HTTP",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/booking",
            "description": "Valida que o endpoint principal retorna os headers e status HTTP corretos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT017 - Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('CT017 - Content-Type é application/json', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('CT017 - Tempo de resposta abaixo de 5000ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.test('CT017 - Resposta não está vazia', function () {",
                  "  pm.expect(pm.response.text()).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT018 - Validar Tratamento de Erros",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{json_invalido"
            },
            "url": "{{baseUrl}}/booking",
            "description": "Envia JSON malformado para verificar como a API trata erros de parsing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CT018 - API responde com código de erro (não 2xx)', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 415, 500]);",
                  "});",
                  "",
                  "pm.test('CT018 - API não retorna 200 para JSON malformado', function () {",
                  "  pm.response.to.not.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
