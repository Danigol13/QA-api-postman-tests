            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"firstname\": \"Daniel\"\n}"
            },
            "url": "{{baseUrl}}/booking",
            "description": "⚠️ BUG002: API retorna HTTP 500 em vez de 400 quando campos obrigatórios estão ausentes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// BUG002: Comportamento esperado seria 400 Bad Request.",
                  "// A API retorna 500 Internal Server Error.",
                  "pm.test('CT007 - [BUG002] API retorna 500 (esperado: 400)', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 500]);",
                  "});",
                  "",
                  "pm.test('CT007 - Status não é 200 (requisição inválida não deve ser aceita)', function () {",
                  "  pm.response.to.not.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CT008 - Criar Reserva com Formato de Data Inválido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"firstname\": \"Daniel\",\n  \"lastname\": \"Souza\",\n  \"totalprice\": 100,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"data-invalida\",\n    \"checkout\": \"outra-data-invalida\"\n  }\n}"
            },
            "url": "{{baseUrl}}/booking",
            "description": "⚠️ BUG001: API aceita datas em formato inválido e retorna 200 em vez de 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// BUG001: API deveria rejeitar datas inválidas com 400.",
                  "// Comportamento atual: aceita e retorna 200.",
                  "pm.test('CT008 - [BUG001] Documentando comportamento atual (200)', function () {",
                  "  // A API aceita data inválida — isso é um defeito documentado.",
                  "  console.log('BUG001: API aceitou data inválida. Status: ' + pm.response.code);",
                  "});",
                  "",
                  "pm.test('CT008 - Comportamento esperado seria 400 Bad Request', function () {",
                  "  // Teste documenta a expectativa correta para rastreabilidade",
                  "  const status = pm.response.code;",
                  "  pm.expect(status, 'BUG001 ativo: API deveria retornar 400 para datas inválidas').to.eql(400);",
                  "});"
                ]
              }
            }
          ]
        },
